# Production deployment (08_Security_and_RBAC.md §8, "Secure error
# responses"): APP_ENV must be `production` and APP_DEBUG must be `false` —
# APP_DEBUG=true leaks stack traces/internal paths into API error responses.
APP_NAME=Deendoon
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=deendoon
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Sprint 1.2 — Security Hardening. Unset defaults to Laravel's own "auto"
# behavior (secure only when the request is actually HTTPS) — safe for
# local HTTP development. Set explicitly to `true` in production (which
# must be HTTPS-only per 08_Security_and_RBAC.md §12), so the session
# cookie is never sent over a plain HTTP connection. This project's
# protected API surface uses Sanctum bearer tokens, not this cookie — it
# only matters for the stock `/` welcome route's session middleware.
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# database/array are the zero-infrastructure local-dev defaults below.
# 01_Project_Overview.md's approved stack names Redis explicitly, and
# 08_Security_and_RBAC.md §8 / 09_Non_Functional_Requirements.md recommend
# a Redis-backed queue/cache/rate-limiter for production — set
# QUEUE_CONNECTION=redis and CACHE_STORE=redis in the real production .env.
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# Phase 14: general API rate limit (AppServiceProvider's 'api' RateLimiter),
# requests/minute per authenticated user (falls back to per-IP if
# unauthenticated). 08 §8 recommends the mechanism without fixing a
# threshold; 60/min is a conventional Laravel/OWASP-baseline default, not an
# approved SRS number — adjust per measured traffic.
API_RATE_LIMIT_PER_MINUTE=60

# Product Owner Decision (Phase 14): Sanctum sliding idle timeout, in
# minutes — a token unused for this long is revoked on its next use
# (EnsureTokenIsNotIdle middleware). 08_Security_and_RBAC.md §3/§9's
# "sliding window, exact duration configurable" requirement.
SANCTUM_IDLE_TIMEOUT=60

# Sprint 1.1 — Password Recovery (FR-004). Minutes a forgot-password token
# remains valid before it must be re-requested. 08_Security_and_RBAC.md
# §10 recommends 15–60 minutes; 60 is the upper end of that range and
# matches Laravel's own stock `config('auth.passwords.users.expire')`.
PASSWORD_RESET_TOKEN_EXPIRY_MINUTES=60

# Sprint 1.2 — Security Hardening. Comma-separated list of trusted proxy
# IPs/CIDRs (or `*` to trust any — only safe if this app is never directly
# reachable except through that proxy/load balancer), so $request->ip()
# resolves the real client IP instead of the proxy's — every IP-keyed rate
# limiter in this project (login/register/forgot-password/reset-password,
# and the general 'api' limiter's unauthenticated fallback) depends on
# this being correct behind any reverse proxy or load balancer.
#
# Product Owner Decision (Sprint 1.2): this value is never hardcoded and
# is left EMPTY by default in this template — application code trusts no
# proxy unless this is set. Deliberately not defaulted to `*` or to any
# specific address, since the real proxy/load-balancer IP range is a fact
# about the production network, not about this codebase. Production
# infrastructure (whoever provisions and deploys the real environment) is
# responsible for setting this correctly for that deployment; the
# application will not guess or assume a value on its behalf.
# TRUSTED_PROXIES=

# Needed so the React + TypeScript Super Admin Web Dashboard (a separate
# browser origin) can call this API — see config/cors.php. Comma-separated
# origins, e.g. https://admin.example.com. Empty (the default) means no
# browser origin is allowed, which will surface as a browser-side CORS
# error with no server-side symptom — documented here so that isn't a
# surprise on a fresh deployment.
CORS_ALLOWED_ORIGINS=

# Sprint 1.2 — Security Hardening. Log level for the dedicated 'security'
# channel (config/logging.php) — failed logins, permission-denied
# responses, idle-token revocations, password-reset requests. Separate
# from LOG_LEVEL so security-relevant events can be retained/alerted on
# independently of general application log verbosity.
SECURITY_LOG_LEVEL=info

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
